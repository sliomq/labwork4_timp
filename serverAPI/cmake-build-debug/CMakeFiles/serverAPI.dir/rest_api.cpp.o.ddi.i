    std::string padding;
    switch (base.size() % 4) {
    case 1: padding += fill; [[fallthrough]];
    case 2: padding += fill; [[fallthrough]];
    case 3: padding += fill; [[fallthrough]];
    default: break;
    }

    return base + padding;
   }

