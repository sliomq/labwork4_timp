            if (__builtin_expect(!!(req.method >= HTTPMethod::InternalMethodCount), 0))
                return found;
            else if (req.method == HTTPMethod::Head)
            {
                *found = per_methods_[static_cast<int>(method_actual)].trie.find(req.url);

                if (!found->rule_index)
                {
