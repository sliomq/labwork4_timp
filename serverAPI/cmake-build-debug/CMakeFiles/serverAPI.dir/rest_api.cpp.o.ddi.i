                }

                if (crow::logger::get_current_log_level() <= crow::LogLevel::Info) crow::logger(crow::LogLevel::Info) << "Cannot match rules " << req.url;
                res = response(404);
                res.end();
                return;
            }

            if (rule_index >= rules.size())
                throw std::runtime_error("Trie internal structure corrupted!");

            if (rule_index == RULE_SPECIAL_REDIRECT_SLASH)
            {
                if (crow::logger::get_current_log_level() <= crow::LogLevel::Info) crow::logger(crow::LogLevel::Info) << "Redirecting to a url with trailing slash: " << req.url;
                res = response(301);
                res.add_header("Location", req.url + "/");
                res.end();
                return;
